diff --git a/sysfile.c b/sysfile.c
index bfe61b7..85aae37 100644
--- a/sysfile.c
+++ b/sysfile.c
@@ -66,18 +66,27 @@ sys_dup(void)
   return fd;
 }
 
+int read_count = 0;
+
 int
 sys_read(void)
 {
   struct file *f;
   int n;
   char *p;
+  read_count++;
 
   if(argfd(0, 0, &f) < 0 || argint(2, &n) < 0 || argptr(1, &p, n) < 0)
     return -1;
   return fileread(f, p, n);
 }
 
+int
+sys_getreadcount(void)
+{
+  return read_count;
+}
+
 int
 sys_write(void)
 {
